# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project URL (safe to share with the team).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Server-only. Bypasses RLS — never expose to the browser, git or chat.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Google AI Studio key for the AI module (src/lib/ai).
GEMINI_API_KEY=
# Optional model override.
# GEMINI_MODEL=gemini-3.8-flash

# "live" uses Gemini via src/lib/ai. "mock" (default) returns a clearly
# marked [MOCK] SR-001 fixture for offline endpoint tests.
AI_MODE=live

# Abort AI calls after this many milliseconds (case → NEEDS_REVIEW).
AI_TIMEOUT_MS=120000

# Test only (mock mode): force a failure path — "invalid" or "timeout". Leave unset.
# AI_MOCK_FAULT=
