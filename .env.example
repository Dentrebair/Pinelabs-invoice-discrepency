# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project URL (safe to share with the team).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Server-only. Bypasses RLS — never expose to the browser, git or chat.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only, owned by Dev 2's AI module.
ANTHROPIC_API_KEY=

# "mock" (default) returns a clearly marked [MOCK] SR-001 fixture.
# Set to "live" once Dev 2's exports are wired into src/lib/server/ai.ts.
AI_MODE=mock

# Abort AI calls after this many milliseconds (case → NEEDS_REVIEW).
AI_TIMEOUT_MS=120000

# Test only (mock mode): force a failure path — "invalid" or "timeout". Leave unset.
# AI_MOCK_FAULT=
